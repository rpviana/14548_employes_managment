@model IEnumerable<_14548_employes_managment.Models.LeaveApplication>

@{
    ViewData["Title"] = "Leave Applications";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Leave Applications</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active">Leave Applications</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid px-3 px-sm-0">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                        <h3 class="card-title mb-2 mb-sm-0">List of Leave Applications</h3>
                        <div class="card-tools">
                            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">New Application</span>
                            </a>
                        </div>
                    </div>
                    <div class="card-body table-responsive">
                        <table id="leaveTable" class="table table-bordered table-striped table-sm">
                            <thead>
                                <tr>
                                    <th style="min-width: 120px;">Employee</th>
                                    <th style="min-width: 100px;">Leave Type</th>
                                    <th style="min-width: 100px;">Start Date</th>
                                    <th style="min-width: 100px;">End Date</th>
                                    <th style="min-width: 60px;">Days</th>
                                    <th style="min-width: 90px;">Duration</th>
                                    <th style="min-width: 90px;">Status</th>
                                    <th style="min-width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Employee?.FullName</td>
                                        <td>@item.LeaveType?.Name</td>
                                        <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">@item.NumberOfDays</td>
                                        <td>@item.Duration?.Description</td>
                                        <td>
                                            @if (item.Status?.Description == "Pending")
                                            {
                                                <span class="badge badge-warning">@item.Status?.Description</span>
                                            }
                                            else if (item.Status?.Description == "Approved")
                                            {
                                                <span class="badge badge-success">@item.Status?.Description</span>
                                            }
                                            else if (item.Status?.Description == "Rejected")
                                            {
                                                <span class="badge badge-danger">@item.Status?.Description</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">@item.Status?.Description</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-info" title="View">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#leaveTable").DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
            }).buttons().container().appendTo('#leaveTable_wrapper .col-md-6:eq(0)');
        });
    </script>
}
