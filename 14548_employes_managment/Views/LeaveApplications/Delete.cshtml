@model _14548_employes_managment.Models.LeaveApplication

@{
    ViewData["Title"] = "Delete Leave Application";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Delete Leave Application</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Leave Applications</a></li>
                    <li class="breadcrumb-item active">Delete</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">Confirm Deletion</h3>
                    </div>
                    <div class="card-body">
                        <h5>Are you sure you want to delete this leave application?</h5>
                        <hr />
                        <dl class="row">
                            <dt class="col-sm-2">
                                <label asp-for="Employee.FullName"></label>
                            </dt>
                            <dd class="col-sm-10">
                                @Model.Employee?.FullName
                            </dd>
                            <dt class="col-sm-2">
                                <label asp-for="LeaveType.Name"></label>
                            </dt>
                            <dd class="col-sm-10">
                                @Model.LeaveType?.Name
                            </dd>
                            <dt class="col-sm-2">
                                <label asp-for="StartDate"></label>
                            </dt>
                            <dd class="col-sm-10">
                                @Model.StartDate.ToString("dd/MM/yyyy")
                            </dd>
                            <dt class="col-sm-2">
                                <label asp-for="EndDate"></label>
                            </dt>
                            <dd class="col-sm-10">
                                @Model.EndDate.ToString("dd/MM/yyyy")
                            </dd>
                            <dt class="col-sm-2">
                                <label asp-for="Status.Description"></label>
                            </dt>
                            <dd class="col-sm-10">
                                @Model.Status?.Description
                            </dd>
                        </dl>
                    </div>
                    <div class="card-footer">
                        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
